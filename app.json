{
  "expo": {
    "name": "LUMINA",
    "slug": "LUMINA",
    "version": "1.0.2",
    "icon": "./public/icons/Icon2.png",
    "splash": {
      "image": "./public/icons/Icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0720"
    },
    "orientation": "portrait",
    "scheme": "lumina",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.u.lumina",
      "versionCode": 3,
      "notification": {
        "icon": "./public/icons/Icon.png",
        "color": "#0B0720"
      },
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/Icon2.png",
        "backgroundColor": "#0B0720"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/Icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e11902b4-a0c0-4318-9bc7-8cfb1c52b8b9"
      }
    }
  }
}
